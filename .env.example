PORT=4000
NODE_ENV=development

# Prefer DATABASE_URL in production (Render/Heroku/etc)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crm_dev

# Or set individual PG* vars instead of DATABASE_URL
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=crm_dev
# PGUSER=postgres
# PGPASSWORD=postgres

# Browser origin(s) allowed in production (comma-separated). In development the API reflects your Origin so
# both http://localhost:5173 and http://127.0.0.1:5173 work without listing every port.
CORS_ORIGIN=http://localhost:5173
# Production example:
# CORS_ORIGIN=https://crm.example.com,https://app.example.com

# Vercel / managed Postgres: enable SSL if the URL has no sslmode= (Neon, Supabase, etc.)
# DATABASE_SSL=1
# Strict cert check (optional): DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Local Postgres without SSL from serverless: DATABASE_SSL=0

# Optional: store uploads in S3 (when AWS_S3_BUCKET and AWS_REGION are set). Uses default AWS credential chain
# (e.g. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY locally, IAM role on AWS).
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_PUBLIC_BASE_URL=https://d111111abcdef8.cloudfront.net
# AWS_S3_KEY_PREFIX=media
# While editing, CRM calls POST /api/upload?draft=1 (local uploads/ only). On campaign save, images are
# uploaded again without draft so they go to S3 when the bucket is configured.
