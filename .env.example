PORT=4000
NODE_ENV=development

# Prefer DATABASE_URL in production (Render/Heroku/Neon/etc)
DATABASE_URL=""

# Or set individual PG* vars instead of DATABASE_URL
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=crm_dev
# PGUSER=postgres
# PGPASSWORD=postgres

# --- Production (Render / hosted API) ---
BACKEND_URL=""
# Your deployed CRM frontend — required for welcome + reset emails and CORS
CORS_ORIGIN=""
CRM_APP_URL=""
# Optional overrides (defaults: CRM_APP_URL + /login and /reset-password)
# CRM_LOGIN_URL=https://crm-five-hazel.vercel.app/login
# CRM_RESET_PASSWORD_URL=https://crm-five-hazel.vercel.app/reset-password

# --- Local dev (uncomment instead of production URLs above) ---
# CORS_ORIGIN=http://localhost:5173
# CRM_APP_URL=http://localhost:5173

JWT_SECRET=change_me_in_production

# 99acres webhook — header: x-api-key (POST + GET)
NINETY_NINE_ACRES_API_KEY=change_me_api_key

# Email (required in production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="PropCRM <your@gmail.com>"

# RESET_TOKEN_TTL_HOURS=1

# S3 media (new uploads + migrate script target base URL)
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_BASE_URL=""
AWS_S3_KEY_PREFIX=""
